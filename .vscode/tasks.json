{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "clang build",                // 任务名称
            "type": "shell",                       // 使用 shell 类型
            "command": "clang",                    // 使用 clang 命令
            "args": [
                "-g",                             // 生成调试信息
                "-o", "${workspaceFolder}/build/cpp",  // 可执行文件路径
                "${workspaceFolder}/src/main.cpp"    // 源文件路径
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
